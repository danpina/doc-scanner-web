# Only needed when deploying to the cloud (e.g. Render). Get these by creating a
# free database at https://turso.tech ("turso db create doc-scanner", then
# "turso db show doc-scanner --url" and "turso db tokens create doc-scanner").
# Leave both unset for local development — the app then just uses a local
# SQLite file at data/scanner.db instead.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Any long random string — used to sign login session cookies. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Only needed to support "Sign in with Apple" (used by the iOS app). Must exactly
# match the iOS app's bundle identifier (see PRODUCT_BUNDLE_IDENTIFIER in
# ios/project.yml) — Apple's identity tokens are issued for that specific audience.
APPLE_BUNDLE_ID=com.danipina.docscanner

# Needed so deleting an account can also revoke its Sign in with Apple token
# (App Store requirement). Create a "Sign in with Apple" key under Certificates,
# Identifiers & Profiles > Keys, then fill these in. APPLE_PRIVATE_KEY is the
# contents of the downloaded .p8 file; in a single-line env var, write the line
# breaks as \n. Leave unset to skip revocation.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
