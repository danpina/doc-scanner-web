# Only needed when deploying to the cloud (e.g. Render). Get these by creating a
# free database at https://turso.tech ("turso db create doc-scanner", then
# "turso db show doc-scanner --url" and "turso db tokens create doc-scanner").
# Leave both unset for local development — the app then just uses a local
# SQLite file at data/scanner.db instead.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Any long random string — used to sign login session cookies. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
